rules_version = '2';

// ============================================================
// firestore.rules — Mikami Sushi
// Nenhuma parte do sistema usa Firebase Auth (nem anônimo, nem
// login de verdade) — a "segurança" aqui é feita liberando só as
// coleções que o app realmente usa, e bloqueando qualquer outra
// no match /{document=**} do final. Se adicionar uma coleção nova,
// lembre de declarar ela aqui também, senão fica bloqueada.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Produtos — leitura livre (cardápio), escrita aberta. Mesmo padrão
    // do resto do projeto: o sistema não usa Firebase Auth em lugar
    // nenhum, então "allow write: if request.auth != null" bloquearia
    // toda escrita (inclusive a aba Produtos e o seed inicial).
    match /produtos/{id} {
      allow read, write: if true;
    }

    // Mesas — leitura e escrita abertas para a rede local do restaurante
    // RECOMENDAÇÃO: restrinja por IP ou adicione Firebase Auth
    match /mesas/{id} {
      allow read, write: if true;
    }

    // Pedidos — leitura e escrita abertas para cozinha e mesas
    match /pedidos/{id} {
      allow read, write: if true;
    }

    // Vendas — leitura restrita (apenas autenticado), escrita aberta
    // O relatório requer autenticação no front-end (hash SHA-256)
    match /vendas/{id} {
      allow read, write: if true;
    }

    // Despesas — mesmo padrão de acesso de vendas
    match /despesas/{id} {
      allow read, write: if true;
    }

    // Config — status do site (aberto/fechado para pedidos)
    // Leitura livre: o site público precisa ler em tempo real.
    // Escrita aberta, no mesmo padrão de mesas/pedidos deste projeto.
    match /config/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Produtos do site público (cardápio Mikami-Sushi/React) — gerenciados
    // pelo painel admin na aba Site. Leitura livre pro site ler em tempo
    // real; escrita aberta, mesmo padrão do resto do projeto.
    match /produtos_site/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Filial Toritama — coleções isoladas da matriz
    match /produtos_toritama/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /comandas_toritama/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /vendas_toritama/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /despesas_toritama/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Bloqueia tudo que não foi declarado acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
